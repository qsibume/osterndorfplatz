# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (resend.com -> API Keys)
RESEND_API_KEY=re_...
# Absender, Domain muss bei Resend verifiziert sein
MAIL_FROM="Ostern 2027 <helfer@deine-domain.ch>"
# Erhält Meldungen, wenn ein Bereich keine Leiter-E-Mail hat
MAIL_FALLBACK=orga@deine-domain.ch

# Öffentliche Adresse der App (für Links in E-Mails)
NEXT_PUBLIC_SITE_URL=https://helfer-ostern.vercel.app

# Standard-Ort für Kalendereinträge
EVENT_LOCATION=Kirche, Musterstrasse 1, 3000 Bern
